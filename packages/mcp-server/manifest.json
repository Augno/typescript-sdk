{
  "dxt_version": "0.2",
  "name": "@augno/sdk-mcp",
  "version": "0.17.0",
  "description": "The official MCP Server for the Augno API",
  "author": {
    "name": "Augno",
    "email": "support@augno.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/augno/typescript-sdk.git"
  },
  "homepage": "https://github.com/augno/typescript-sdk/tree/main/packages/mcp-server#readme",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/index.js"
      ],
      "env": {
        "AUGNO_API_KEY": "${user_config.AUGNO_API_KEY}",
        "AUGNO_AUGNO_ACCOUNT_ID": "${user_config.AUGNO_AUGNO_ACCOUNT_ID}"
      }
    }
  },
  "user_config": {
    "AUGNO_API_KEY": {
      "title": "bearer_token",
      "description": "API key sent as a Bearer token. Omit for cookie-based user sessions (dashboard).",
      "required": false,
      "type": "string"
    },
    "AUGNO_AUGNO_ACCOUNT_ID": {
      "title": "augno_account_id",
      "description": "Current account UUID (Augno-Account). Update when switching accounts.",
      "required": false,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": [
    "api"
  ]
}
